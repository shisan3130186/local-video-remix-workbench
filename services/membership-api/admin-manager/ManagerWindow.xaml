<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="智剪卡密管理器" Width="1120" Height="720" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="#111315" Foreground="#F4F6F8"
        FontFamily="Microsoft YaHei UI" ResizeMode="CanResize">
  <Window.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#181B1E" />
    <SolidColorBrush x:Key="PanelRaisedBrush" Color="#1E2226" />
    <SolidColorBrush x:Key="BorderBrush" Color="#30353A" />
    <SolidColorBrush x:Key="MutedBrush" Color="#929AA3" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2B93A2" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#35A5B6" />
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#F4F6F8" />
      <Setter Property="Background" Value="#24282C" />
      <Setter Property="BorderBrush" Value="#3A4046" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Background" Value="#30363B" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Border" Property="Background" Value="#202428" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#F4F6F8" /><Setter Property="Background" Value="#121518" />
      <Setter Property="BorderBrush" Value="#363C42" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,8" /><Setter Property="CaretBrush" Value="#F4F6F8" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#1A1D20" /><Setter Property="Background" Value="#F0F2F4" />
      <Setter Property="Padding" Value="8,5" />
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="#15181B" /><Setter Property="Foreground" Value="#E7EAED" />
      <Setter Property="BorderBrush" Value="#30353A" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" /><Setter Property="HorizontalGridLinesBrush" Value="#292E33" />
      <Setter Property="RowBackground" Value="#15181B" /><Setter Property="AlternatingRowBackground" Value="#191D20" />
      <Setter Property="HeadersVisibility" Value="Column" /><Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="IsReadOnly" Value="True" /><Setter Property="SelectionMode" Value="Single" />
      <Setter Property="CanUserAddRows" Value="False" /><Setter Property="CanUserDeleteRows" Value="False" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#202428" /><Setter Property="Foreground" Value="#AEB5BC" />
      <Setter Property="BorderBrush" Value="#30353A" /><Setter Property="Padding" Value="10,9" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="10,7" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid Margin="0,0,0,20">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Border Width="42" Height="42" CornerRadius="8" Background="#25373B" BorderBrush="#35636B" BorderThickness="1">
          <TextBlock Text="剪" FontSize="21" FontWeight="Bold" Foreground="#73CBD7" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Margin="12,0,0,0">
          <TextBlock Text="智剪卡密管理器" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Text="SmartCut License Manager · 仅管理员本机使用" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
        </StackPanel>
      </StackPanel>
      <Button x:Name="CloseButton" Grid.Column="1" Content="关闭" VerticalAlignment="Center" Padding="18,8" />
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="330" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
        <StackPanel>
          <TextBlock Text="生成新兑换码" FontSize="17" FontWeight="SemiBold" />
          <TextBlock Text="每个兑换码只能使用一次，会员天数会叠加到用户账号。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,18" />
          <TextBlock Text="快捷时长" Foreground="#C8CDD2" Margin="0,0,0,8" />
          <UniformGrid Columns="3" Rows="2" Margin="0,0,0,16">
            <Button x:Name="Day1Button" Content="1天测试" Margin="0,0,6,6" />
            <Button x:Name="Day7Button" Content="7天" Margin="0,0,6,6" />
            <Button x:Name="Day30Button" Content="30天" Margin="0,0,0,6" />
            <Button x:Name="Day90Button" Content="90天" Margin="0,0,6,0" />
            <Button x:Name="Day365Button" Content="365天" Margin="0,0,6,0" />
            <Button x:Name="ClearButton" Content="清空" />
          </UniformGrid>
          <TextBlock Text="会员天数" Foreground="#C8CDD2" Margin="0,0,0,7" />
          <TextBox x:Name="DaysInput" Text="30" Margin="0,0,0,14" />
          <TextBlock Text="内部备注" Foreground="#C8CDD2" Margin="0,0,0,7" />
          <TextBox x:Name="LabelInput" Text="30天会员" MaxLength="80" Margin="0,0,0,16" />
          <Button x:Name="GenerateButton" Content="生成并复制兑换码" Style="{StaticResource PrimaryButton}" Padding="16,11" />
          <Border Background="#121A1C" BorderBrush="#2B5960" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="最新生成" Foreground="{StaticResource MutedBrush}" />
              <TextBlock x:Name="CodeText" Text="尚未生成" FontFamily="Consolas" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,10" TextWrapping="Wrap" />
              <Button x:Name="CopyButton" Content="复制兑换码" IsEnabled="False" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
          <TextBlock Text="安全提示：不要把管理员令牌文件发送给任何人。" Foreground="#D2A96B" TextWrapping="Wrap" Margin="0,16,0,0" />
        </StackPanel>
      </Border>

      <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="兑换码记录" FontSize="17" FontWeight="SemiBold" />
              <TextBlock Text="查看使用状态，管理尚未使用的兑换码。" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <ComboBox x:Name="FilterCombo" Grid.Column="1" SelectedIndex="0" VerticalAlignment="Center" Margin="12,0">
              <ComboBoxItem Content="全部状态" Tag="all" /><ComboBoxItem Content="未使用" Tag="unused" />
              <ComboBoxItem Content="已使用" Tag="redeemed" /><ComboBoxItem Content="已停用" Tag="disabled" />
            </ComboBox>
            <Button x:Name="RefreshButton" Grid.Column="2" Content="刷新列表" VerticalAlignment="Center" />
          </Grid>
          <UniformGrid Grid.Row="1" Columns="3" Margin="0,16,0,14">
            <Border Background="{StaticResource PanelRaisedBrush}" CornerRadius="5" Padding="14" Margin="0,0,8,0">
              <StackPanel><TextBlock Text="未使用" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="UnusedCount" Text="0" FontSize="21" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel>
            </Border>
            <Border Background="{StaticResource PanelRaisedBrush}" CornerRadius="5" Padding="14" Margin="4,0">
              <StackPanel><TextBlock Text="已使用" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="RedeemedCount" Text="0" FontSize="21" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel>
            </Border>
            <Border Background="{StaticResource PanelRaisedBrush}" CornerRadius="5" Padding="14" Margin="8,0,0,0">
              <StackPanel><TextBlock Text="已停用" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="DisabledCount" Text="0" FontSize="21" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel>
            </Border>
          </UniformGrid>
          <DataGrid x:Name="CodesGrid" Grid.Row="2" AlternationCount="2">
            <DataGrid.Columns>
              <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="82" />
              <DataGridTextColumn Header="天数" Binding="{Binding DaysText}" Width="66" />
              <DataGridTextColumn Header="备注" Binding="{Binding LabelText}" Width="*" MinWidth="130" />
              <DataGridTextColumn Header="兑换账号" Binding="{Binding RedeemedBy}" Width="170" />
              <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAtText}" Width="145" />
            </DataGrid.Columns>
          </DataGrid>
          <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="SelectionHint" Text="选择一条记录后可管理未使用卡密。" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
            <Button x:Name="DisableButton" Grid.Column="1" Content="停用所选" IsEnabled="False" Margin="0,0,8,0" />
            <Button x:Name="EnableButton" Grid.Column="2" Content="恢复所选" IsEnabled="False" />
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="2" Margin="0,16,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" Text="准备就绪" Foreground="#8ECBD3" />
      <TextBlock x:Name="LastRefreshText" Grid.Column="1" Text="尚未刷新" Foreground="{StaticResource MutedBrush}" />
    </Grid>
  </Grid>
</Window>
