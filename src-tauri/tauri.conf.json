{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "本地短视频批量混剪工作台",
  "version": "0.1.0",
  "identifier": "com.shisan.local-video-remix-workbench",
  "build": {
    "beforeDevCommand": "corepack pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "corepack pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["**/*"]
      }
    },
    "windows": [
      {
        "title": "本地短视频批量混剪工作台",
        "width": 1100,
        "height": 760,
        "minWidth": 860,
        "minHeight": 560
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
